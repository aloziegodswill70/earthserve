                    <a class="transition-all inline-block whitespace-nowrap cursor-pointer no-underline border-solid size-16 tracking-75 font-normal uppercase px-11 py-3 hover:border-transparent ml-0 mr-2 leading-relaxed border-current hover:text-black rounded-none border-2" data-bg="rgba(242, 252, 251, 0)" data-hover-bg="rgb(251,204,127)" href="https://forms.gle/1TcJZWRJBTuKzwLA7" onmouseout="if(this.getAttribute('data-bg'))this.style.backgroundColor=this.getAttribute('data-bg');else this.style.backgroundColor=''" onmouseover="if(this.getAttribute('data-hover-bg'))this.style.backgroundColor=this.getAttribute('data-hover-bg');" style="background-color: rgba(242, 252, 251, 0); color: rgb(251, 204, 127);" title="" target="_blank">Get in Touch</a>
